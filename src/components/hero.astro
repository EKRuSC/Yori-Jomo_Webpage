---
import Button from "./button.astro";
---

<section id="hero">
  <div class="grid">
    <div id="logo">
      <p class="p_logo">yori jomo</p>
    </div>
    <div id="hero_content">
      <p class="sh1">Designet i København.<br />Håndlavet i Toscana.</p>
      <p class="p_loud">Håndlavede sko fra Toscana<br />til kvinder, der vælger med omtanke.</p>
    </div>
    <Button buttext="Udforsk Kollektion Nu" />
  </div>
</section>

<style>
  #hero {
    background-color: #9f9f9f;
    background-image: url(../assets/images/Sorte\ krokodilleskindsloafers.png);
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;

    /*----------|LOGO_CONTAINER|----------*/
    #logo {
      /*|GRID-FIT|*/
      grid-column: 2 / -2;
      grid-row: 7 / span 5;
      /*|LAYOUT|*/
      container-name: logo;
      container-type: size;
      .p_logo {
        font-size: clamp(var(--f-sz_400), 10cqw, 100cqh);
      }
    }
    @media screen and (width <= 1024px) {
      #logo {
        /*|GRID-FIT|*/
        grid-column: 2 / -2;
        grid-row: 7 / span 4;
        /*|LAYOUT|*/
        container-name: logo;
        container-type: size;
        .p_logo {
          font-size: clamp(var(--f-sz_400), 10cqw, 100cqh);
        }
      }
    }

    /*----------|CONTENT_CONTAINER|----------*/
    #hero_content {
      /*|GRID-FIT|*/
      grid-column: 2 / -2;
      grid-row: 13 / span 6;
      /*|LAYOUT|*/
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      /*|STYLING|*/
      text-wrap: balance;
    }
    @media screen and (width <= 1024px) {
      #hero_content {
        /*|GRID-FIT|*/
        grid-column: 2 / -2;
        grid-row: 12 / span 6;
        /*|LAYOUT|*/
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        /*|STYLING|*/
        text-wrap: balance;
      }
    }

    /*----------|BUTTON_CONTAINER|----------*/
    button {
      /*|GRID-FIT|*/
      grid-column: 2 / -2;
      grid-row: 21 / span 2;
      /*|LAYOUT|*/
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
