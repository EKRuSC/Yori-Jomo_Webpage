---
import IconSearch from "../assets/graphics/Yori-Jomo_Icon-Search.svg";
import IconShop from "../assets/graphics/Yori-Jomo_Icon-Shop.svg";
import IconInstagram from "../assets/graphics/Yori-Jomo_Icon-Instagram.svg";
---

<header>
  <div class="grid">
    <div id="logo">
      <p class="p_logo">yori jomo</p>
    </div>
    <nav>
      <a id="wrapper1" href=""><p class="p_nav">shop</p></a>
      <a id="wrapper2" href=""><p class="p_nav">nyheder</p></a>
      <a id="wrapper3" href=""><p class="p_nav">om os</p></a>
    </nav>
    <div id="icons">
      <a class="icon_wrapper" href=""><IconSearch class="icon" /></a>
      <a class="icon_wrapper" href=""><IconShop class="icon" /></a>
      <a class="icon_wrapper" href=""><IconInstagram class="icon" /></a>
    </div>
  </div>
</header>

<style>
  header {
    /*|LAYOUT|*/
    position: absolute;
    z-index: 0;
    width: 100%;
    #logo,
    nav,
    div {
      height: 100%;
      align-items: center;
    }
  }

  /*----------|LOGO_CONTAINER|----------*/
  #logo {
    /*|GRID-FIT|*/
    grid-column: 1 / span 3;
    grid-row: 1/3;
    /*|LAYOUT|*/
    container-name: logo;
    container-type: size;
    .p_logo {
      text-wrap: nowrap;
      font-size: clamp(var(--f-sz_200), 10cqw, var(--f-sz_400));
    }
  }
  @media screen and (width <= 1024px) {
    #logo {
      /*|GRID-FIT|*/
      grid-column: 1 / 3;
      grid-row: 1/3;
      /*|LAYOUT|*/
      container-name: logo;
      container-type: size;
      .p_logo {
        text-wrap: nowrap;
        font-size: clamp(var(--f-sz_200), 10cqw, var(--f-sz_400));
      }
    }
  }

  /*----------|NAV_MENU|----------*/
  nav {
    /*|GRID-FIT|*/
    grid-column: 4/-4;
    grid-row: 1 / 3;
    /*|LAYOUT|*/
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--f-lh_100);
    a {
      grid-column: span 2;
      height: fit-content;
      width: fit-content;
      padding: 0 4px;
      justify-self: center;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #wrapper1 {
      justify-self: end;
    }
    #wrapper3 {
      justify-self: start;
    }
  }
  @media screen and (width <= 1024px) {
    nav {
      /*|GRID-FIT|*/
      grid-column: 3/-3;
      grid-row: 1 / 3;
      /*|LAYOUT|*/
      padding: 0;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: var(--f-lh_100);
    }
  }

  /*----------|ICONS_MENU|----------*/
  #icons {
    /*|GRID-FIT|*/
    grid-column: -4/-1;
    grid-row: 1 / 3;
    /*|LAYOUT|*/
    display: flex;
    flex-direction: row;
    justify-content: end;
    gap: var(--f-lh_100);
    .icon_wrapper {
      aspect-ratio: 1/1;
      height: var(--f-lh_200);
      display: flex;
      align-items: center;
      justify-content: center;
      .icon {
        height: 100%;
        width: 100%;
      }
    }
  }
</style>
